{
  "api": {
    "port": 9527,
    "cors_origins": ["http://localhost:9528", "http://127.0.0.1:9528", "http://localhost:9527", "http://127.0.0.1:9527"]
  },
  "llm": {
    "model": "deepseek-chat",
    "fast_model": "",
    "slow_model": "",
    "fast_model_threshold": 100,
    "temperature": 0.7,
    "max_tokens": 2048
  },
  "agent": {
    "max_iterations": 5,
    "max_history": 50,
    "session_cleanup_interval": 600,
    "session_db_ttl": 86400
  },
  "ffmpeg": {
    "default_crf": 23,
    "default_preset": "medium",
    "gpu_acceleration": true
  },
  "video": {
    "source_type": "pexels",
    "max_upload_size_mb": 500
  },
  "ui": {
    "theme": "dark",
    "language": "zh-CN"
  }
}
