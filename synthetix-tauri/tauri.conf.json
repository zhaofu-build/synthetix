{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Synthetix",
  "version": "0.1.0",
  "identifier": "com.synthetix.app",
  "build": {
    "frontendDist": "../synthetix-vue/dist",
    "beforeDevCommand": "npm --prefix ../synthetix-vue run build",
    "beforeBuildCommand": "npm --prefix ../synthetix-vue run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Synthetix - AI 视频剪辑",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/backend"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
